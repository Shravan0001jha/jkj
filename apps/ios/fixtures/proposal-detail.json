  "item": {
    "id": "ib-4",
    "kind": "org-change",
    "title": "Split \"mobile\" into iOS and Android, hire an Android lead",
    "body": "The mobile queue is at 7 and Android work keeps waiting on iOS. Asha proposes two charters and one hire from the lead template.",
    "summary": "Asha proposes splitting mobile into iOS and Android and hiring an Android lead.",
    "details": "Queue at 7; Android waits on iOS every time. Two charters replace mobile; 6 map entries move; Arjun hired at ₹150/day.",
    "context": {
      "proposalId": "op-1",
      "kind": "split",
      "diff": "--- charters/mobile.md\n+++ charters/mobile-ios.md\n+++ charters/mobile-android.md\n map.yaml: 6 entries move to mobile-android"
    },
    "options": [
      {
        "id": "approve",
        "label": "Approve the split and hire"
      },
      {
        "id": "reject",
        "label": "Reject",
        "needsNote": true
      }
    ],
    "state": "open",
